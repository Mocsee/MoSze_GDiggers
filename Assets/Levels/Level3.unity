  m_Script: {fileID: 11500000, guid: e4625909c840b5d47a7b3f4c626206e4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCInteractable
  dialogueLines:
  - "A sz\xEDnek m\xE1r teljesen elt\u0171ntek, sajnos egyre k\xF6zelebb a v\xE9g."
  - "Adj bele mindent \xE9s teljes\xEDtsd az utols\xF3 megpr\xF3b\xE1ltat\xE1st! "
  - "Grimble m\xE1r f\xE1rad \xE9s itt az es\xE9ly, hogy meg\xE1ll\xEDtsd!"
  - "De vigy\xE1zz, a vesz\xE9lyb\u0151l egyre t\xF6bb lett, innen is l\xE1tszik,
    hogy k\xF6zel a c\xE9l."
  - "Ha ezt a p\xE1ly\xE1t teljes\xEDted, \xFAjra elhozzuk a f\xE9nyt Clover Vale-be. "
  - 'Sok sikert! '
  speechText: {fileID: 1316490141}
  speechBubbleObject: {fileID: 1137268283}
  playerMovement: {fileID: 0}
  interactPromptObject: {fileID: 0}
  npcSprite: {fileID: 89875412}
  normalColor: {r: 1, g: 1, b: 1, a: 1}
  highlightColor: {r: 1, g: 1, b: 0.7, a: 1}
  disappearAfterDialogue: 0
